        {
            "questId": "guinevere_sword_1",
            "title": "Mountain Courtesy",
            "description": "Guinevere is researching in the upper mountain. The white wyverns up there have opinions about visitors. She'd like you to express a counter-opinion, and pick up some materials while you're at it.",
            "startRequirement": {
                "operator": "AND",
                "conditions": [
                    {
                        "type": "have_tag",
                        "tag": "claudia_sr1_complete"
                    },
                    {
                        "type": "have_tag",
                        "tag": "cygwin_sr1_complete"
                    }
                ]
            },
            "stages": [
                {
                    "objective": "Defeat 3 White Wyverns near the shrine",
                    "requirement": {
                        "type": "kill",
                        "enemyId": "white_wyvern",
                        "quantity": 3
                    },
                    "unavailable_dialogue": [
                        "The wyverns up here don't take to strangers.",
                        "I've been interrupted three times this morning already.",
                        "I don't suppose you'd be willing to do something about that?"
                    ],
                    "intro_dialogue": [
                        "Sylvie said to expect you eventually.",
                        "She was right. She usually is, about people.",
                        "I've heard about what you did with Claudia and Cygwin's operation.",
                        "Good. That's the kind of thing worth hearing about.",
                        "Now — I have a more immediate problem.",
                        "The white wyverns in this part of the mountain don't like outsiders.",
                        "I've been chased off my research site twice today.",
                        "If you defeat three of them, the rest will get the idea and keep their distance.",
                        "Wyverns are territorial, not stupid. It won't take more than that."
                    ],
                    "reminder_dialogue": [
                        "Three wyverns. The rest will back off once they understand the message.",
                        "They're territorial. They'll learn."
                    ],
                    "success_dialogue": [
                        "Good. That should buy me a few hours at least.",
                        "While you're here — I need dragon fangs.",
                        "Five of them. I'm working on a stabilisation compound.",
                        "The energy readings around these nucleation sites fluctuate — the compound should help me take more accurate samples.",
                        "The wyverns carry them, but so do the rock formations deeper in.",
                        "Either way."
                    ]
                },
                {
                    "objective": "Bring Guinevere 5 Dragon Fangs",
                    "requirement": {
                        "type": "give_item",
                        "itemId": "dragon_fang",
                        "quantity": 5
                    },
                    "reminder_dialogue": [
                        "The dragon fangs. Five of them.",
                        "Take your time — the wyverns should be giving you a wider berth now."
                    ],
                    "success_dialogue": [
                        "Perfect.",
                        "These will do exactly what I need.",
                        "You know, most people who come up here come for the view.",
                        "You came because Claudia and Cygwin pointed you here, and you followed without asking too many questions.",
                        "I appreciate that quality.",
                        "Come back when you've had a chance to look around the shrine grounds.",
                        "There's more here than the wyverns would have you believe."
                    ],
                    "success_rewards": [
                        {
                            "type": "world_resonance",
                            "amount": 8
                        },
                        {
                            "type": "tag",
                            "tagId": "guinevere_sword_1_complete"
                        }
                    ]
                }
            ]
        },
        {
            "questId": "guinevere_sword_2",
            "title": "The Tree",
            "description": "Guinevere wants something from the Dragonblood Tree. What you do with that request is up to you.",
            "startRequirement": {
                "type": "have_tag",
                "tag": "guinevere_sword_1_complete"
            },
            "stages": [
                {
                    "objective": "Speak with Guinevere",
                    "requirement": {
                        "type": "dialogue"
                    },
                    "unavailable_dialogue": [
                        "You see that tree over there?",
                        "The one that shouldn't be blooming in this altitude, in this season.",
                        "The Dragon Empire planted them across the island.",
                        "Breath Points, they called them — places where the earth's energy ran close to the surface.",
                        "There are scholars who have spent careers on trees like this.",
                        "You should travel the island. Talk to people who know the old histories.",
                        "It changes how you see everything up here."
                    ],
                    "intro_dialogue": [
                        "You came back.",
                        "Good timing.",
                        "I need to ask you something."
                    ],
                    "success_dialogue": [
                        "The Dragonblood Tree.",
                        "I need a sample of the heartwood.",
                        "Just one. It'll grow back — these trees are resilient in ways that defy easy explanation.",
                        "I can't retrieve it myself. The tree doesn't respond well to my approach.",
                        "I've tried.",
                        "You, on the other hand — I suspect it will let you close.",
                        "It's level 5 woodcutting. You'll know if you're ready.",
                        "I'm not going to tell you what I need it for yet.",
                        "Bring it back first. Then we'll talk."
                    ],
                    "success_rewards": [
                        {
                            "type": "tag",
                            "tagId": "guinevere_sword_2_started"
                        }
                    ]
                },
                {
                    "objective": "Retrieve heartwood from the Dragonblood Tree — or leave it standing",
                    "requirement": {
                        "type": "give_item",
                        "itemId": "dragonblood_heartwood",
                        "quantity": 1
                    },
                    "refusable": true,
                    "refuse_dialogue": [
                        "You're not going to cut it.",
                        "...",
                        "I thought that might happen.",
                        "Claudia warned me you'd be difficult.",
                        "I'm choosing to find that charming.",
                        "The tree stands. My research takes a different route.",
                        "I won't pretend I'm not disappointed.",
                        "But I won't pretend you made the wrong call either.",
                        "Come back. We're not done."
                    ],
                    "refuse_rewards": [
                        {
                            "type": "tag",
                            "tagId": "guinevere_sword_2_complete"
