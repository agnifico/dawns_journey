                            "requirement": { "type": "dialogue" },
                            "success_dialogue": [
                                "You chose differently.",
                                "I'm not angry.",
                                "I want to understand.",
                                "Not to argue. I've made my choice. I'm not reconsidering.",
                                "I just — I think about the math.",
                                "My math says: this path, this cost, this outcome.",
