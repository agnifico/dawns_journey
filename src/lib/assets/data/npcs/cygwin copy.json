            "stages": [
                {
                    "objective": "Speak with Cygwin",
                    "requirement": { "type": "dialogue" },
                    "unavailable_dialogue": [
                        "I got a message from home.",
                        "Give me a moment with it.",
                        "Come back soon."
                    ],
                    "intro_dialogue": [
                        "News from home.",
                        "Come in."
                    ],
                    "success_dialogue": [
                        "There's a girl.",
                        "Eleven years old. My village.",
                        "Her name is Sera.",
                        "The investment has been running long enough that there's a school now.",
                        "A real one. With teachers who came specifically.",
                        "Sera is — they say she's exceptional.",
                        "Better than I was at her age.",
                        "Faster. Smarter. And she has access to things I never had.",
                        "My mother wrote to tell me.",
                        "She said — 'this is why you went'.",
                        "I read it six times.",
                        "Claudia found me on the seventh and I had to pretend I had something in my eye.",
                        "She didn't believe me.",
                        "She brought chocolates.",
                        "She always brings chocolates.",
                        "I don't know what I would do without her.",
                        "Or Guinevere.",
                        "Or — well.",
                        "You've become part of that list.",
                        "I don't say that lightly.",
                        "I don't say most things lightly."
                    ],
                    "success_rewards": [
                        { "type": "world_resonance", "amount": 10 },
                        { "type": "tag", "tagId": "cygwin_sword_4_complete" }
                    ]
                }
            ]
        },
        {
