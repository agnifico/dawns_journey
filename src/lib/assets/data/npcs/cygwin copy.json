        {
            "questId": "cygwin_sword_1",
            "title": "The Decrepit Spire",
            "description": "Commander Cygwin needs an old spire activated. She has her reasons, and she'll share them if you earn it.",
            "startRequirement": {
                "type": "have_tag",
                "tag": "can_assist_cygwin"
            },
            "stages": [
                {
                    "objective": "Speak with Cygwin",
                    "requirement": { "type": "dialogue" },
                    "unavailable_dialogue": [
                        "I'm busy.",
                        "Come back when I'm not looking at this map."
                    ],
                    "intro_dialogue": [
                        "Guinevere sent you.",
                        "Good. I have something that needs doing and my hands are full.",
                        "There's an old spire in the southern forest — predates the Saints by a long time.",
                        "We need it active as part of the platform network.",
                        "It's not complicated. But it needs someone I can trust to do it quietly.",
                        "Guinevere says I can trust you.",
                        "That's enough for me."
                    ],
                    "reminder_dialogue": [
                        "Southern forest. Old spire.",
                        "Take your time, but not too much of it."
                    ],
                    "success_rewards": [
                        { "type": "tag", "tagId": "cygwin_ready_for_f2" }
                    ]
                },
                {
                    "objective": "Activate the Decrepit Spire",
                    "requirement": {
                        "type": "finish_location_event",
                        "eventId": "F2",
                        "timing": "future"
                    },
                    "reminder_dialogue": [
                        "The spire is still waiting.",
                        "Southern forest. You'll feel the pull when you're close."
                    ],
                    "success_dialogue": [
                        "Platform network is stabilising.",
                        "Good work.",
                        "You want to know why that spire specifically?",
                        "My people used to use structures like that.",
                        "Different purpose. Same principle — drawing from what's already in the earth, not forcing something new into it.",
                        "The Saints' method is cruder.",
                        "It works. But it's cruder.",
                        "I've been trying to suggest adjustments.",
                        "It's a process.",
                        "Come back. I want to show you something."
                    ],
                    "success_rewards": [
                        { "type": "world_resonance", "amount": 5 },
                        { "type": "tag", "tagId": "cygwin_sword_1_complete" }
                    ]
                }
            ]
        },
        {
            "questId": "cygwin_sword_2",
            "title": "What the Earth Remembers",
            "description": "Cygwin wants to show you something about the southern forest. About what was here before.",
            "startRequirement": {
                "type": "have_tag",
                "tag": "cygwin_sword_1_complete"
            },
            "stages": [
                {
                    "objective": "Follow Cygwin into the southern forest",
                    "requirement": {
                        "type": "finish_location_event",
                        "eventId": "cygwin_southern_forest_walk"
                    },
                    "unavailable_dialogue": [
                        "Southern forest. Come find me when you're ready.",
                        "I'll be at the old marker stones."
                    ],
                    "intro_dialogue": [
                        "Walk with me.",
                        "I want to show you something before the platform work changes it."
                    ],
                    "success_dialogue": [
                        "My people have a word for this.",
                        "For ground that remembers what lived and died on it.",
                        "The southern forest is full of it.",
                        "The platforms haven't reached this far yet.",
                        "When they do —",
                        "The leakage will change the soil composition. The older root systems will struggle.",
                        "I know this because I read the projections.",
                        "I know this because I grew up walking ground like this.",
                        "I made a promise to Guinevere. To the Saints. To my people.",
                        "That promise requires the platforms.",
                        "I'm not second-guessing the promise.",
                        "But I wanted someone else to see this before it changes.",
                        "Claudia would have cried.",
                        "You seem like you could hold it.",
                        "I was right."
                    ],
                    "success_rewards": [
                        { "type": "world_resonance", "amount": 8 },
                        { "type": "tag", "tagId": "cygwin_sword_2_complete" }
                    ]
                }
            ]
        },
        {
            "questId": "cygwin_sword_3",
            "title": "The Promised Warrior",
            "description": "Cygwin tells you about where she came from. She doesn't do this often.",
            "startRequirement": {
                "type": "have_tag",
                "tag": "cygwin_sword_2_complete"
            },
            "stages": [
                {
                    "objective": "Speak with Cygwin",
                    "requirement": { "type": "dialogue" },
                    "unavailable_dialogue": [
                        "Give me a moment.",
                        "Some things need the right time to say."
                    ],
                    "intro_dialogue": [
                        "I want to tell you something.",
                        "Sit down."
                    ],
                    "success_dialogue": [
                        "Where I come from, some children are marked early.",
                        "Not chosen. Marked.",
                        "It means the community looks at you and says — this one will carry something for all of us.",
                        "I was marked when I was nine.",
                        "My mother cried.",
                        "Not because she was sad. Because she was proud and scared at the same time.",
                        "I grew up knowing that my strength was not for me.",
                        "Which sounds heavy.",
                        "It wasn't, mostly. It was just — true.",
                        "When the Saints came with their relief work, I saw what organised resources could do.",
                        "And I thought — if I give them myself, fully, without reservation —",
                        "They give my people a future.",
                        "Not survival. A future.",
                        "Bonnie thinks this was too much to give.",
                        "She's not wrong.",
                        "She's also not the one who made the promise.",
                        "I don't regret it.",
                        "I want to be clear about that.",
                        "I just wanted you to know what it cost.",
                        "You're the kind of person it's worth being honest with."
                    ],
                    "success_rewards": [
                        { "type": "world_resonance", "amount": 10 },
                        { "type": "tag", "tagId": "cygwin_sword_3_complete" }
                    ]
                }
            ]
        },
        {
            "questId": "cygwin_sword_4",
            "title": "Other Cygwins",
            "description": "Cygwin has news from home. The investment is working. She's not sure how to feel about it.",
