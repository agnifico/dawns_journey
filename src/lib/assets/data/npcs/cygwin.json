        {
            "questId": "cygwin_sword_2",
            "title": "What the Earth Remembers",
            "description": "Cygwin has been thinking about what she told you. She wants to say the rest of it.",
            "startRequirement": {
                "type": "have_tag",
                "tag": "cygwin_sword_1_complete"
            },
            "stages": [
                {
                    "objective": "Speak with Cygwin",
                    "requirement": {
                        "type": "dialogue"
                    },
                    "unavailable_dialogue": [
                        "I'm still working out how to say this.",
                        "Come back soon."
                    ],
                    "intro_dialogue": [
                        "I've been thinking about what I told you.",
                        "About the correlation.",
                        "There's more."
                    ],
                    "success_dialogue": [
                        "Where I come from, we have a concept.",
                        "The ground remembers.",
                        "Not metaphorically.",
                        "Literally — the composition of the soil changes based on what happened on it.",
                        "What lived and died. What was built and burned.",
                        "I grew up reading ground the way some people read texts.",
                        "The ground here is like nothing I've encountered.",
                        "The nucleation sites — where the swords are emerging — the substrate around them is ancient.",
                        "Pre-Concordat. Pre-human settlement.",
                        "Something massive happened here, a long time ago.",
                        "The swords are the residue.",
                        "I don't know what they were before.",
                        "I intend to find out.",
                        "Gabriella wants a report.",
                        "I'm going to give her one.",
                        "A carefully edited one.",
                        "Come back. I want to show you something.",
                        "When we're both ready."
                    ],
                    "success_rewards": [
                        {
                            "type": "world_resonance",
                            "amount": 8
                        },
                        {
                            "type": "tag",
                            "tagId": "cygwin_sword_2_complete"
                        }
                    ]
                }
            ]
        },
        {
